# Trash & recovery snapshots
.trash/
**/.trash/
.obsidian.rollback-temp-*/
.obsidian.safe-reset-*/

# Claude Code local settings (machine-specific paths)
.claude/

# Python build artifacts
__pycache__/
*.pyc

# Windows / shell crash dumps
*.stackdump

# Quartz / Node
site/node_modules/
site/quartz/.quartz-cache/
public/
